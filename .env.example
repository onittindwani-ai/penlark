# Penlark environment. Names only. Copy to .env and fill in what you use. Never commit .env. Every name is explained in docs/04-ENVIRONMENT-VARIABLES.md.
# A line left empty (NAME=) counts as not set. Groups below marked "all or none" are switched off while empty and must be filled in completely once you start.

# Core
APP_NAME=penlark
DATABASE_URL=sqlite:///./penlark.sqlite3
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (32 or more random characters; the app refuses to start on this example value when DEMO_MODE is false)
SESSION_SECRET=change-me-to-a-long-random-string
# draft: nothing is sent to a scheduling tool. live: an approved, confirmed draft may be sent, only after docs/09-GO-LIVE-CHECKLIST.md
MODE=draft
# false for any real install. true is the offline demo with fictional data (it also switches on a public demo password until OWNER_PASSWORD_HASH is set)
DEMO_MODE=false
# Only for a throw away demo on a server database. Leave false.
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
# The largest request the API accepts, in bytes (25 MB)
MAX_BODY_BYTES=26214400
# The day that "today" means for exports and the calendar, for example Europe/London or America/New_York
TIMEZONE=UTC
# The hour of the day (0 to 23, in TIMEZONE) at which a send for a chosen day goes out
SEND_HOUR=9
# Docker compose only: the database password. Letters and digits only. Make one: openssl rand -hex 24
POSTGRES_PASSWORD=
# The folder with the demo data. Set automatically when you run from the repository; the Docker image sets it itself.
SEED_DIR=

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
LOGIN_BURST=5

# House rules (no dashes in marketing text by default; set NO_DASHES=false for a client whose style uses them)
NO_DASHES=true
MAX_READING_GRADE=9
MIN_VOICE_MATCH=60
REQUIRE_SOURCES=true
# Posts a week per platform, shown on the Calendar as a plan. It never blocks anything.
CADENCE=linkedin:2,x:2

# Model for drafts: offline (default, built in template writer, no account), fixture (recorded answers) or anthropic (needs a key, UNVERIFIED against the real service)
LLM_BACKEND=offline
# The older switch: live means anthropic when LLM_BACKEND is empty. Leave it.
LLM_MODE=fixture
# With a model backend on: which jobs the model does (rules or model). Code re scores every model draft; a person still approves.
GUIDE_WRITER=model
DRAFT_WRITER=model
IDEA_FINDER=rules
# Live model settings (not needed for the demo, never run by the author)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
# One model name for both kinds, when you want that
LLM_MODEL=
# Seconds per request, the reply size limit, and retries after a busy or failed answer
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# Most live calls per process and most tracked spend in US dollars, then the model path stops. Empty means no limit. A spend limit needs a model with a known price (claude-sonnet-5-5, claude-haiku-5-5), or the app refuses to start.
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
# default or off
LLM_THINKING=default
# Where recorded answers are read from (fixture) or written to (LLM_RECORD=true)
LLM_FIXTURES_DIR=
LLM_RECORD=false
# Logs and recorded answers never hold a full prompt or a key. Log a shortened, redacted prompt only when you are debugging.
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Where an approved draft goes
SCHEDULER_ADAPTER=export
EXPORT_DIR=./exports

# Tracked links and lead events: the allow list names the hosts a link may point at, for example your own site and booking page. Empty means no link works.
PUBLIC_BASE_URL=http://localhost:3000
REDIRECT_ALLOW_HOSTS=
LEAD_WEBHOOK_SECRET=
# Only for a Postiz or other scheduling tool you run yourself on a private address or plain http. Leave false otherwise.
ALLOW_PRIVATE_SCHEDULER=false
ALLOW_HTTP_LOCAL_TARGETS=false

# Postiz scheduler, all or none
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# Buffer scheduler, all or none
BUFFER_TOKEN=
BUFFER_BASE_URL=https://api.buffer.com

# Metricool scheduler, all or none
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_BASE_URL=https://app.metricool.com/api

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
INSECURE_COOKIES=
